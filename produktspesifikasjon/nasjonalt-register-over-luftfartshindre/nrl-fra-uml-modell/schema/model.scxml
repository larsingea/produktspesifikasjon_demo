         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>visuell merking benyttet ved merking av luftfartshinder</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
