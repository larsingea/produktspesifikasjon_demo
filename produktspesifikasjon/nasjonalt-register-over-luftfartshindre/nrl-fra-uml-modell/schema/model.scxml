        </sc:Property>
        <sc:Property>
         <sc:name>datafangstdato</sc:name>
         <sc:id>C1_9</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>dato sist gang objektet ble stedfestet</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeName>Date</sc:typeName>
        </sc:Property>
        <sc:Property>
